events {}
http {
  server_tokens off;
  client_max_body_size 15m;   # evidencias fotográficas

  upstream microservicios { server {{ ip.vm3 }}:30080; }

  # WebSocket: seguimiento en tiempo real (API) y Grafana Live
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_certificate     /etc/nginx/certs/quickpatch.crt;
  ssl_certificate_key /etc/nginx/certs/quickpatch.key;
  ssl_protocols TLSv1.2 TLSv1.3;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  # Producción. Es el servidor por defecto: entrar por IP o por un nombre desconocido cae aquí.
  server {
    listen {{ ansible_host }}:443 ssl default_server;
    server_name {{ gateway_hosts.produccion }};

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
      proxy_pass http://microservicios/;
    }

    # Panel Angular (SPA): archivos estáticos servidos aquí mismo
    location / {
      root /usr/share/nginx/panel;
      try_files $uri $uri/ /index.html;
    }
  }

  # QA (VM2). Mismo build del panel que producción, servido en la raíz por el Nginx de VM2.
  # Solo red del equipo: el panel de QA todavía no tiene login.
  server {
    listen {{ ansible_host }}:443 ssl;
    server_name {{ gateway_hosts.qa }};
{% for red in team_networks %}
    allow {{ red }};
{% endfor %}
    deny all;

    # TLS termina aquí. QA es un k3s en VM2 (ADR-022): el gateway y el panel de QA entran por Traefik.
    location / {
      proxy_pass http://{{ ip.vm2 }}:30080;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }

  # Grafana (VM7). Prometheus no se publica: Grafana lo consulta dentro del laboratorio.
  server {
    listen {{ ansible_host }}:443 ssl;
    server_name {{ gateway_hosts.grafana }};
{% for red in team_networks %}
    allow {{ red }};
{% endfor %}
    deny all;

    location / {
      proxy_pass http://{{ ip.vm1 }}:3000;   # Grafana, en la propia VM1 (ADR-022)
    }
  }
}
