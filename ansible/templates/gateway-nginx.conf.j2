events {}
http {
  server_tokens off;
  client_max_body_size 15m;   # evidencias fotográficas

  upstream microservicios { server {{ ip.vm3 }}:30080; }

  server {
    listen {{ ansible_host }}:443 ssl;
    server_name quickpatch.internal;
    ssl_certificate     /etc/nginx/certs/quickpatch.crt;
    ssl_certificate_key /etc/nginx/certs/quickpatch.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
      proxy_pass http://microservicios/;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;   # WebSocket para el seguimiento en tiempo real
      proxy_set_header Connection "upgrade";
    }

    # Panel Angular (SPA): archivos estáticos servidos aquí mismo
    location / {
      root /usr/share/nginx/panel;
      try_files $uri $uri/ /index.html;
    }
  }
}
