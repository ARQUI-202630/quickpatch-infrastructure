local   all   postgres                    peer
host    all   postgres   127.0.0.1/32     scram-sha-256
# El k3s de QA está en VM5: sus pods salen a la red con la IP del nodo (ADR-021)
{% for db in postgres_databases %}
host    db_{{ db }}   app_{{ db }}   {{ ip.vm5 }}/32    scram-sha-256
{% endfor %}
