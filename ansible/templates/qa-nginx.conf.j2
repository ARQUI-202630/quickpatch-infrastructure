events {}
http {
  server_tokens off;
  client_max_body_size 15m;
  server {
    listen {{ ansible_host }}:443 ssl;
    server_name qa.quickpatch.internal;
    ssl_certificate     /etc/nginx/certs/qa.crt;
    ssl_certificate_key /etc/nginx/certs/qa.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Ambiente QA always;

    location /api/ {
      proxy_pass http://{{ ip.vm5 }}:30080/;   # Traefik del k3s de QA en VM5 (ADR-021)
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
    location / {
      root /usr/share/nginx/panel;
      try_files $uri $uri/ /index.html;
    }
  }
}
