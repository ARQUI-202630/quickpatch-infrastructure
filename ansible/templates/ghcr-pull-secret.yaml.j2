{# Secret para que el k3s descargue las imágenes privadas de GHCR (el paquete no puede ser público: lo impide la organización). #}
{# Sale por la entrada estándar de kubectl: el token nunca aparece en la línea de comandos. #}
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: quickpatch
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{{ {"auths": {"ghcr.io": {"username": vault_ghcr_pull.usuario, "password": vault_ghcr_pull.token, "auth": (vault_ghcr_pull.usuario ~ ":" ~ vault_ghcr_pull.token) | b64encode}}} | to_json }}'
