# Red de host: ufw controla los puertos 9000, 9001, 3100, 3000 y 9090.
services:
{% if object_storage_enabled %}
  minio:
    image: {{ images.minio }}
    network_mode: host
    restart: unless-stopped
    command: server /data --address {{ ansible_host }}:9000 --console-address {{ ansible_host }}:9001
    environment:
      MINIO_ROOT_USER: "{{ vault_minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ vault_minio_root_password }}"
    volumes:
      - minio-data:/data

{% endif %}
  prometheus:
    image: {{ images.prometheus }}
    network_mode: host
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=15d
      - --web.listen-address={{ ansible_host }}:9090
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  loki:
    image: {{ images.loki }}
    network_mode: host
    restart: unless-stopped
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - ./loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki

  grafana:
    image: {{ images.grafana }}
    network_mode: host
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_ADDR: {{ ansible_host }}
      GF_SERVER_HTTP_PORT: "3000"
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - ./grafana-provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana

volumes:
{% if object_storage_enabled %}
  minio-data:
{% endif %}
  prometheus-data:
  loki-data:
  grafana-data:
