# Red de host: ufw controla los puertos 9000 (S3 de Garage), 3100, 3000 y 9090.
services:
  garage:
    image: {{ images.garage }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - ./garage.toml:/etc/garage.toml:ro
      - garage-meta:/var/lib/garage/meta
      - garage-data:/var/lib/garage/data

  prometheus:
    image: {{ images.prometheus }}
    network_mode: host
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=15d
      - --web.listen-address={{ ansible_host }}:9090
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  loki:
    image: {{ images.loki }}
    network_mode: host
    restart: unless-stopped
    command: -config.file=/etc/loki/loki.yml
    volumes:
      - ./loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki

  grafana:
    image: {{ images.grafana }}
    network_mode: host
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_ADDR: {{ ansible_host }}
      GF_SERVER_HTTP_PORT: "3000"
      GF_SERVER_ROOT_URL: "https://{{ gateway_hosts.grafana }}/"   # se entra por el gateway de VM1 (ADR-015)
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SMTP_ENABLED: "{{ 'true' if vault_smtp_password | default('') | length > 0 else 'false' }}"
      GF_SMTP_HOST: "{{ smtp_servidor }}"
      GF_SMTP_USER: "{{ smtp_usuario }}"
      GF_SMTP_PASSWORD: "{{ vault_smtp_password | default('') }}"
      GF_SMTP_FROM_ADDRESS: "{{ smtp_usuario }}"
      GF_SMTP_FROM_NAME: "QUICKPATCH Grafana"
      GF_SMTP_STARTTLS_POLICY: MandatoryStartTLS
    volumes:
      - ./grafana-provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana

volumes:
  garage-meta:
  garage-data:
  prometheus-data:
  loki-data:
  grafana-data:
