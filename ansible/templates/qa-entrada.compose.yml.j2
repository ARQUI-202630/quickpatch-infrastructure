# QA, entrada, en VM2 (ADR-021): solo Nginx, que sirve el panel y reenvía /api/ al k3s de QA (VM5).
# Red de host: ufw solo abre el 443 (equipo y k6 desde VM1).
services:
  nginx:
    image: {{ images.nginx }}
    network_mode: host
    restart: unless-stopped
{% if ansible_os_family == 'RedHat' %}    security_opt: [label=disable]   # SELinux: leer la configuración montada
{% endif %}    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./certs:/etc/nginx/certs:ro
      - ./panel:/usr/share/nginx/panel:ro
