# QA, datos, en VM6 (ADR-021): PostgreSQL, Redis, Kafka y Garage. Red de host: ufw solo deja entrar al k3s de QA (VM5).
services:
  postgres:
    image: {{ images.postgis }}
    network_mode: host
    restart: unless-stopped
{% if ansible_os_family == 'RedHat' %}    security_opt: [label=disable]   # SELinux: leer la configuración montada
{% endif %}    environment:
      POSTGRES_PASSWORD: "{{ vault_qa_postgres_superuser_password }}"
      POSTGRES_INITDB_ARGS: "--auth-host=scram-sha-256"
    command:
      - postgres
      - -c
      - listen_addresses={{ ansible_host }},127.0.0.1
      - -c
      - hba_file=/etc/postgresql/pg_hba.conf
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./init:/docker-entrypoint-initdb.d:ro
      - ./pg_hba.conf:/etc/postgresql/pg_hba.conf:ro

  redis:
    image: {{ images.redis }}
    network_mode: host
    restart: unless-stopped
{% if ansible_os_family == 'RedHat' %}    security_opt: [label=disable]   # SELinux: leer la configuración montada
{% endif %}    command: >
      redis-server --bind {{ ansible_host }} 127.0.0.1 --port 6379
      --requirepass {{ vault_qa_redis_password }}
      --maxmemory {{ qa_redis_maxmemory }} --maxmemory-policy allkeys-lru --appendonly no

  kafka:
    image: {{ images.kafka }}
    network_mode: host
    restart: unless-stopped
{% if ansible_os_family == 'RedHat' %}    security_opt: [label=disable]   # SELinux: leer la configuración montada
{% endif %}    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://{{ ansible_host }}:9092,CONTROLLER://127.0.0.1:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://{{ ansible_host }}:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@127.0.0.1:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "false"
      KAFKA_LOG_RETENTION_HOURS: 24
      KAFKA_HEAP_OPTS: "{{ qa_kafka_heap }}"
    volumes:
      - kafka-data:/var/lib/kafka/data

  garage:
    image: {{ images.garage }}
    network_mode: host
    restart: unless-stopped
{% if ansible_os_family == 'RedHat' %}    security_opt: [label=disable]   # SELinux: leer la configuración montada
{% endif %}    volumes:
      - ./garage.toml:/etc/garage.toml:ro
      - garage-meta:/var/lib/garage/meta
      - garage-data:/var/lib/garage/data

volumes:
  pgdata:
  kafka-data:
  garage-meta:
  garage-data:
