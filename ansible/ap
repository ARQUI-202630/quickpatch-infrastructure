#!/usr/bin/env bash
# Ejecuta ansible-playbook dentro del contenedor. Uso: ./ap playbooks/diagnostico.yml -k -K
# Si existe ~/.config/quickpatch/vault-pass, se usa como clave del vault (no está en el repo).
set -euo pipefail
cd "$(dirname "$0")"
VAULT=()
[ -f "$HOME/.config/quickpatch/vault-pass" ] && VAULT=(-v "$HOME/.config/quickpatch/vault-pass:/run/vault-pass:ro" -e ANSIBLE_VAULT_PASSWORD_FILE=/run/vault-pass)
docker run --rm -it --network host \
  -v "$PWD":/ansible \
  -v "$HOME/.ssh":/root/.ssh:ro \
  "${VAULT[@]}" \
  -e ANSIBLE_CONFIG=/ansible/ansible.cfg \
  quickpatch-ansible "$@"
